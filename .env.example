# Copy this file to .env and fill in your values.
# Only one DATABASE_URL should be active at a time — uncomment whichever
# environment you're targeting and comment out the other.

# --- Local development (Docker) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/merlin_dev"

# --- Production (Neon) ---
# DATABASE_URL="postgresql://user:password@host/db?sslmode=require&channel_binding=require"
# DIRECT_URL="postgresql://user:password@host/db?sslmode=require&channel_binding=require"

OPENAI_API_KEY="openai-key-here"